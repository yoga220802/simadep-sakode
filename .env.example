# .env.example
# Copy ke .env.local lalu edit:
# cp .env.example .env.local

# Base URL untuk API SMIP (client-side)
# contoh dev: localhost; contoh prod: https://api.myproject.com
NEXT_PUBLIC_API_SMIP_BASE_URL=http://localhost:3000/api

# Pusher (client-side — publishable keys, bukan secret)
# contoh app key (publishable): format bebas, ini hanya sample
NEXT_PUBLIC_PUSHER_APP_KEY=pk_test_ABC123xyz

# Cluster/region Pusher, mis. ap1, eu, us2
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# Gunakan 'true' kalau pakai TLS/HTTPS; 'false' kalau tidak
NEXT_PUBLIC_PUSHER_TLS=true
