# .env.example
# Copy ke .env.local lalu edit:
# cp .env.example .env.local

# Base URL untuk API SIMADEP (client-side)
# contoh dev: localhost; contoh prod: https://api.myproject.com
NEXT_PUBLIC_API_SIMADEP_BASE_URL=http://localhost:3000/api

# Pusher (client-side — publishable keys, bukan secret)
# contoh app key (publishable): format bebas, ini hanya sample
NEXT_PUBLIC_PUSHER_APP_KEY=pk_test_ABC123xyz

# Cluster/region Pusher, mis. ap1, eu, us2
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# Gunakan 'true' kalau pakai TLS/HTTPS; 'false' kalau tidak
NEXT_PUBLIC_PUSHER_TLS=true

# Database lokal untuk Drizzle/MySQL. Jangan isi credential production di file ini.
DATABASE_URL=mysql://simadep:simadep@127.0.0.1:3306/simadep

# URL aplikasi server-side. Dipakai oleh auth/runtime server saat fase berikutnya.
APP_URL=http://localhost:3000

# Placeholder fase auth berikutnya. Ganti dengan secret panjang saat Better Auth dipasang.
BETTER_AUTH_SECRET=replace-with-a-long-random-local-secret
BETTER_AUTH_URL=http://localhost:3000
