# .env.example
# Copy ke .env.local lalu edit:
# cp .env.example .env.local

# Pusher client-side publishable config.
NEXT_PUBLIC_PUSHER_APP_KEY=pk_test_ABC123xyz
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
NEXT_PUBLIC_PUSHER_TLS=true

# Pusher server-side. Kosongkan untuk menonaktifkan publish realtime.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_CLUSTER=ap1

# Database lokal untuk Drizzle/MySQL. Jangan isi credential production di file ini.
DATABASE_URL=mysql://simadep_app:SimadepLocal2026_App@127.0.0.1:3306/simadep_dev

# URL aplikasi server-side.
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-local-secret
BETTER_AUTH_URL=http://localhost:3000

# Local-only bootstrap admin. Do not use production credentials here.
SIMADEP_BOOTSTRAP_ADMIN_EMAIL=admin.local@simadep.test
SIMADEP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-local-temp-password
SIMADEP_BOOTSTRAP_ADMIN_NAME=SIMADEP Admin
SIMADEP_BOOTSTRAP_ADMIN_EMPLOYEE_NUMBER=SIMADEP-ADMIN

# Attachment storage. Local is used for development/tests.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=.local/uploads

# Cloudinary skeleton config. Do not commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# FCM push notification adapter. Kosongkan untuk mode disabled.
# FCM_ACCESS_TOKEN adalah short-lived OAuth access token untuk FCM HTTP v1.
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
