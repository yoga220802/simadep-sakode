# .env.example
# Copy ke .env.local lalu edit:
# cp .env.example .env.local

# Pusher Channels client-side publishable config.
# Isi dari "App Keys" Pusher: key + cluster. Aman untuk NEXT_PUBLIC.
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
NEXT_PUBLIC_PUSHER_TLS=true

# Pusher Channels server-side. Kosongkan untuk menonaktifkan publish realtime.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_CLUSTER=ap1

# Database lokal untuk Drizzle/MySQL. Jangan isi credential production di file ini.
DATABASE_URL=mysql://simadep_app:SimadepLocal2026_App@127.0.0.1:3306/simadep_dev

# URL aplikasi server-side.
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-local-secret
BETTER_AUTH_URL=http://localhost:3000
CRON_SECRET=replace-with-vercel-cron-secret-min-16-chars
OUTBOX_CRON_SECRET=replace-with-a-long-random-local-cron-secret

# Local-only bootstrap admin. Do not use production credentials here.
SIMADEP_BOOTSTRAP_ADMIN_EMAIL=myadmin.simadep@sakode.com
SIMADEP_BOOTSTRAP_ADMIN_PASSWORD=simadep@sakode
SIMADEP_BOOTSTRAP_ADMIN_NAME=My Admin SIMADEP
SIMADEP_BOOTSTRAP_ADMIN_EMPLOYEE_NUMBER=SIMADEP-ADMIN

# Deterministic local seed accounts created by npm run db:seed use:
# password: simadep@sakode

# Attachment storage.
# local: simpan file di filesystem lokal; cocok untuk development/tests.
# cloudinary: upload file ke Cloudinary; LOCAL_STORAGE_ROOT tidak dipakai.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=.local/uploads

# Cloudinary upload/delete config. Required ketika STORAGE_PROVIDER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# FCM push notification adapter. Kosongkan untuk mode disabled.
# FCM_ACCESS_TOKEN adalah short-lived OAuth access token untuk FCM HTTP v1.
# Device token user didaftarkan lewat POST /api/notifications/device-tokens.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FCM_VAPID_KEY=
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
